meta {
  name: Shipment Created By Order
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/shipping/shipments/order/{{orderId}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{token}}
}

script:post-response {
  const body = res.getBody();
  if (body && body.data) {
    bru.setEnvVar("shipmentId", body.data.id);
    bru.setEnvVar("shipmentNumber", body.data.shipmentNumber);
  }
}
