meta {
  name: Login Viewer
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "viewer@smartlogix.cl",
    "password": "viewer123"
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.data && body.data.accessToken) {
    bru.setEnvVar("token", body.data.accessToken);
  }
}
